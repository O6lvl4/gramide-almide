// lexer — how Almide is lexed: a `Spec` for the shared lexer in gramide.
//
// Everything about the language that a table can describe is here: keywords,
// operators, comment markers, what a newline means, and the named families for
// the two things a table cannot, how numbers are written and how strings end.
import gramide.lex
import gramide.tree

// ── how Almide is lexed ───────────────────────────────────────────────────
//
// `&&` and `||` are not Almide (it has `and` / `or`), but lexing them as one
// token each makes the parse error name the whole operator a writer typed
// rather than half of it. The four foreign keywords at the end of KEYWORDS are
// there for the same reason: rejecting them makes `return x` or `class Foo`
// fail instead of parsing as two statements.
let KEYWORDS = ["module", "import", "type", "protocol", "for", "in", "fn", "let", "var", "mut", "if", "then", "else",
  "match", "true", "false", "not", "and", "or", "pub", "effect", "test", "guard", "break", "continue", "while",
  "local", "mod", "fan",
  "return", "class", "impl", "deriving", "newtype"]

let OPERATORS = ["..<", "...", "?.", "??", "->", "=>", "==", "!=", "<=", ">=", "|>", ">>", "**", "..", "&&", "||",
  "=", "+", "-", "*", "/", "%", "^", "<", ">", "!", "?", ".", ",", ":", ";", "(", ")", "[", "]",
  "{", "}", "|", "@", "&", "#"]

fn spec() -> lex.Spec = lex.Spec {
  keywords: KEYWORDS,
  operators: OPERATORS,
  numbers: lex.N_ALMIDE,
  strings: lex.S_ALMIDE,
  newlines: lex.NL_EVERY,
  ends_kw: [],
  line_comment: [47, 47],                 // //
  block_open: [47, 42],                   // /*
  block_close: [42, 47],                  // */
  nested_block: true,
  block_comment_newline: false,
  upper_is_type: true,
  backtick_ident: true,
  neg_token: true,
}

// ── lexing ────────────────────────────────────────────────────────────────

test "words, keywords, numbers, operators" {
  let src = "fn add(x: Int) -> Int = x + 0x1F"
  let toks = lex.tokenize(src, spec())!
  assert_eq(lex.texts(bytes.from_string(src), toks), ["fn", "add", "(", "x", ":", "Int", ")", "->", "Int", "=", "x", "+", "0x1F", "", ""])
  assert_eq(lex.kinds(toks), ["keyword", "identifier", "punct", "identifier", "punct", "type_name", "punct", "punct", "type_name", "punct", "identifier", "punct", "integer", "newline", "eof"])
}

test "floats and ranges do not eat each other" {
  let src = "1.5 1..5 xs.0 2e3"
  assert_eq(lex.texts(bytes.from_string(src), lex.tokenize(src, spec())!), ["1.5", "1", "..", "5", "xs", ".", "0", "2e3", "", ""])
}

test "strings: escapes, interpolation with nested braces and quotes, heredoc, raw" {
  let src = "\"a\\\"b\" \"x \${ f({y: \"}\"}) } z\" \"\"\"\nmulti\n\"\"\" r\"\"\"raw \\ \"\"\" 'q'"
  let toks = lex.tokenize(src, spec())!
  assert_eq(lex.kinds(list.take(toks, 5)), ["string", "string", "string", "string", "string"])
  assert_eq(list.get(lex.texts(bytes.from_string(src), toks), 1), some("\"x \${ f({y: \"}\"}) } z\""))
}

test "an unterminated string is an error with a position" {
  assert_eq(result.is_err(lex.tokenize("let s = \"abc", spec())), true)
  match lex.tokenize("let s = \"abc", spec()) { err(e) => { assert_eq(e.line, 1); assert_eq(e.col, 9) }, ok(_) => assert(false) }
}

test "comments vanish, newlines collapse, `?` is always its own token, backtick names" {
  let src = "// c\nfn f() = 1 /* a /* b */ c */\n\n\nfn is_ok?(x: Int) -> Bool = x?\nlet `type` = 1\n"
  let toks = lex.tokenize(src, spec())!
  assert_eq(lex.texts(bytes.from_string(src), toks), ["fn", "f", "(", ")", "=", "1", "", "fn", "is_ok", "?", "(", "x", ":", "Int", ")", "->", "Bool", "=", "x", "?", "", "let", "`type`", "=", "1", "", ""])
  assert_eq(list.get(lex.kinds(toks), 22), some("identifier"))
}

test "line and column are 1-based and survive a heredoc" {
  let src = "a\n\"\"\"\nx\n\"\"\"\nb"
  let source = bytes.from_string(src)
  let toks = lex.tokenize(src, spec())!
  let b = list.find(toks, (t) => tree.token_text(source, t) == "b")
  assert_eq(option.map(b, (t) => t.line), some(5))
  assert_eq(option.map(b, (t) => t.col), some(1))
}
