// symbols — which of this grammar's nodes declare a name, which own methods,
// and which reference one: the rules the readers in gramide walk with.
// The tests are what those readers then say about a small Almide file.
import gramide.package_api
import gramide.lex
import gramide.parser
import gramide.tags
import self.lexer
import self.grammar

fn symbol_rules() -> package_api.SymbolRules = package_api.SymbolRules {
  declarations: [("function_declaration", "function"), ("type_declaration", "type"), ("let_declaration", "let"), ("test_declaration", "test"), ("protocol_declaration", "protocol"), ("variant", "variant"), ("field", "field")],
  scopes: ["type_declaration", "protocol_declaration"], namespaces: [], callables: ["function_declaration", "method_declaration", "method_signature"],
  lexical_owners: false, envelopes: [], unnamed_envelopes: [],
  arguments: "arguments", field_access: "field_access", type_mentions: ["type_name"]
}

test "definitions, calls and type mentions" {
  let src = "type P = { x: Int }\nfn area(p: P) -> Int = int.abs(p.x) * sq(2)\n"
  let source = bytes.from_string(src)
  let toks = lex.tokenize(src, lexer.spec()) |> result.map_err((e) => e.message)!
  let p = parser.parse(grammar.rules(), source, toks) |> result.map_err((f) => parser.format_failure(f))!
  assert_eq(tags.tags(p.root, toks, source, p.names, ".", symbol_rules()), ["def type P L1-1", "def field x L1-1", "ref type Int L1", "def function area L2-2", "ref type P L2", "ref type Int L2", "ref call int.abs L2", "ref call sq L2"])
}
